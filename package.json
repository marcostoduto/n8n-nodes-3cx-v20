{
  "name": "@marcostoduto/n8n-nodes-3cx-v20",
  "version": "1.0.2",
  "description": "Nodo n8n per 3CX v20: login con token (Web Client o API client) e Configuration API (XAPI)",
  "keywords": [
    "n8n-community-node-package",
    "3cx",
    "xapi",
    "pbx"
  ],
  "license": "MIT",
  "author": {
    "name": "marcostoduto"
  },
  "homepage": "https://github.com/marcostoduto/n8n-nodes-3cx-v20#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marcostoduto/n8n-nodes-3cx-v20.git"
  },
  "bugs": {
    "url": "https://github.com/marcostoduto/n8n-nodes-3cx-v20/issues"
  },
  "main": "index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && node scripts/copy-icons.js",
    "dev": "tsc --watch",
